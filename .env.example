NEXT_PUBLIC_SERVER_URL=/api
BACKEND_URL=http://localhost:8000
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
# Публичный адрес сайта (sitemap.xml, robots.txt).
NEXT_PUBLIC_SITE_URL=https://showring.app
# true — открыть сайт поисковикам и AI-краулерам; иначе robots.txt закрыт
# и на всех ответах X-Robots-Tag: noindex.
NEXT_PUBLIC_SITE_INDEXING=false

# CSP (src/proxy.ts): enforce | report-only | off.
CSP_MODE=enforce
